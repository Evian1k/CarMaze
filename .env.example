# CARMAZE — environment template. NAMES ONLY: never commit real values.
# Copy to .env and fill. The app validates critical variables at boot and
# names (never values) anything missing in health checks and error responses.

# ── Required in production ──────────────────────────────────────────────
DATABASE_URL=                        # SQLite connection (already configured here)
AUTH_SECRET=                         # ≥32 chars — boot refuses production without it. Generate: openssl rand -base64 48
NEXT_PUBLIC_SITE_URL=                # public origin; must match the HTTPS domain Daraja calls back to

# ── M-Pesa Daraja · STK (payments) ──────────────────────────────────────
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=                     # Paybill/shortcode
MPESA_PASSKEY=                       # Lipa na M-Pesa online passkey
MPESA_ENV=                           # sandbox | production
MPESA_CALLBACK_URL=                  # https://<domain>/api/billing/mpesa/callback
MPESA_WEBHOOK_SECRET=                # x-carmaze-signature; fail-closed in production without it

# ── M-Pesa Daraja · B2C (supplier settlement payouts) ───────────────────
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=           # initiator password encrypted with the Daraja public cert
MPESA_B2C_RESULT_URL=                # https://<domain>/api/admin/settlements/payout/result

# ── Email (SMTP) ────────────────────────────────────────────────────────
SMTP_URL=                            # e.g. smtps://USER:KEY@smtp.host:465
MAIL_FROM=                           # e.g. CARMAZE <no-reply@domain>

# ── SMS ─────────────────────────────────────────────────────────────────
SMS_PROVIDER=                        # africastalking | twilio
SMS_API_KEY=
SMS_USERNAME=                        # AT username / Twilio Account SID
SMS_SENDER_ID=                       # approved sender ID

# ── Operations ──────────────────────────────────────────────────────────
ENABLE_JOBS=                         # default true; false disables scheduled sweeps on secondary workers
LOG_LEVEL=                           # default info
MPESA_BASE_URL=                      # optional override of the Daraja API base (default per MPESA_ENV)

# ── Upload malware scanning (recommended in production) ─────────────────
# CARMAZE_SCAN_CMD=                   # optional custom scanner command (exit 0=clean, 1=infected);
#                                     # when unset, the app auto-uses clamdscan/clamscan if installed.
#                                     # Without any scanner: document/evidence uploads stay quarantined
#                                     # until staff approve them after review (fail-closed; audited).
