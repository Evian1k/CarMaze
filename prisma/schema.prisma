  refCode   String    @unique
  userId    String?
  name      String
  email     String
  subject   String
  message   String
  status    String    @default("OPEN") // OPEN|IN_PROGRESS|RESOLVED
  response  String?
  createdAt DateTime  @default(now())

  @@index([status, createdAt])
  @@index([userId])
}

// ───────────────────────── Ops & auditing ─────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorName  String?
  action     String
  targetType String?
  targetId   String?
  metadata   String?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([action])
}

model AiUsage {
  id        String   @id @default(cuid())
  userId    String?
  feature   String
  ok        Boolean
  error     String?
  createdAt DateTime @default(now())
}

model SystemSetting {
  key       String   @id
  value     String // JSON
  updatedAt DateTime @updatedAt
}

model ViewEvent {
  id        String   @id @default(cuid())
  key       String   @unique
  createdAt DateTime @default(now())
}

// ───────────────────────── CARMAZE Partner Network ─────────────────────────
// Inspection, insurance, finance, towing, parts, transport partners.
// Partners are only publicly listed after real verification (status APPROVED
// + verified). Applications come from the public form; staff approve in the
// Control Center. Suspended partners disappear from public listings.

model Partner {
  id           String   @id @default(cuid())
  refCode      String   @unique
  name         String
  category     String   // INSPECTION | INSURANCE | FINANCE | TOWING | PARTS | TRANSPORT | OTHER
  county       String
  serviceAreas String?  // JSON string[] of counties/areas served
  description  String?
  logoUrl      String?
  coverUrl     String?
  phone        String?
  email        String?
  whatsapp     Boolean  @default(false)
  website      String?
  contactName  String?
  status       String   @default("PENDING") // PENDING | APPROVED | SUSPENDED | REJECTED
  verified     Boolean  @default(false)
  rating       Float?   // computed from partner feedback; null = no ratings yet
  referrals    Int      @default(0) // tracked referral requests sent via the platform
  notes        String?  // internal staff notes — never exposed publicly
  rejectionReason String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  requests PartnerRequest[]
}

// A customer request routed to a partner (referral tracking + audit trail).
model PartnerRequest {
  id        String   @id @default(cuid())
  refCode   String   @unique
  partnerId String
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  userId    String?
  name      String
  phone     String
  email     String?
  county    String
  message   String
  status    String   @default("NEW") // NEW | CONTACTED | CLOSED
  createdAt DateTime @default(now())
}

// ───────────────────── CARMAZE Loyalty & Referrals ─────────────────────
// Transparent points ledger. Points are earned through real, verifiable
// activity (referrals that complete registration, eligible reviews,
// completed garage services). Points are never purchasable.

model LoyaltyLedger {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  points    Int      // positive = earned, negative = redeemed
  reason    String   // REFERRAL_SIGNUP | REVIEW_EARNED | SERVICE_COMPLETED | ADJUSTMENT
  refType   String?  // e.g. USER, ORG_REVIEW, BOOKING
  refId     String?
  note      String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([reason])
}

// ═══════════════════════════════════════════════════════════════════════
// CARMAZE AUTOMOTIVE SUPPLY NETWORK
// Extends the platform (same Org/User identity graph) with a verified
// B2B supply marketplace: multi-branch businesses, structured product
// catalogue with fitment data, protected supplier→garage orders with
// delivery verification, and governed business programmes.
// Money stays in integer minor units. JSON is stored as strings.
// ═══════════════════════════════════════════════════════════════════════

// ───────────────────── Multi-branch infrastructure ─────────────────────
// One branch model serves garages, showrooms and suppliers (warehouses).

model OrgBranch {
  id             String   @id @default(cuid())
  orgId          String
  org            Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name           String
  code           String   // short business-wide code, unique per org
  kind           String   @default("BRANCH") // BRANCH | WAREHOUSE
  isPrimary      Boolean  @default(false)
  address        String?
  county         String
  town           String?
  lat            Float?
  lng            Float?
  phone          String?
  managerName    String?
  operatingHours String?  // JSON {"mon":["08:00","18:00"],…}
  deliveryAreas  String?  // JSON string[] of counties/areas served
  status         String   @default("ACTIVE") // ACTIVE | CLOSED

  vehicles      Vehicle[]
  productStocks ProductStock[]
  stockMovements StockMovement[]
  transfersOut  VehicleTransfer[] @relation("TransferFromBranch")
  transfersIn   VehicleTransfer[] @relation("TransferToBranch")
  poDestinations PurchaseOrder[]  @relation("PODestinationBranch")
  deliveriesFrom Delivery[]        @relation("DeliverySupplierBranch")

  @@unique([orgId, code])
  @@index([orgId, status])
}

// ───────────────────────── Product catalogue ─────────────────────────

model ProductCategory {
  id        String  @id @default(cuid())
  slug      String  @unique
  name      String
  parentSlug String? // one-level tree via slug reference
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  products Product[]
}

model Product {
  id                String   @id @default(cuid())
  refCode           String   @unique
  supplierOrgId     String
  supplier          Org      @relation(fields: [supplierOrgId], references: [id], onDelete: Cascade)
  categoryId        String
  category          ProductCategory @relation(fields: [categoryId], references: [id])
  name              String
  sku               String   // unique per supplier
  mpn               String?  // manufacturer part number
  oemRef            String?  // OEM reference where available
  brand             String?
  description       String
  condition         String   @default("NEW") // NEW | REFURBISHED | USED
  unitPriceMinor    Int
  wholesalePriceMinor Int?
  wholesaleMinQty   Int      @default(0) // qty required to unlock wholesale price
  currency          String   @default("KES")
  taxRatePct        Float    @default(0)
  warrantyMonths    Int      @default(0) // 0 = none offered
  returnable        Boolean  @default(false)
  images            String?  // JSON string[] of image urls
  tags              String?  // JSON string[]
  vehicleMakes      String?  // JSON string[] quick-filter makes
  batchTracked      Boolean  @default(false)
  serialTracked     Boolean  @default(false)
  // Provenance / authenticity evidence — admin-reviewed, never supplier self-asserted.
  // JSON { authorizationDocUrl, provenanceNote, authenticator: "ADMIN" | null }
  provenance        String?
  authenticityVerified Boolean @default(false) // ONLY settable by platform admins
  status            String   @default("DRAFT") // DRAFT | PUBLISHED | SUSPENDED | REJECTED
  featured          Boolean  @default(false)
  ratingAvg         Float?
  ratingCount       Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  stocks        ProductStock[]
  compat        ProductCompatibility[]
  reviews       ProductReview[]
  priceHistory  ProductPriceHistory[]
  poItems       POItem[]
  stockAlerts   GarageStockAlert[]
  customerOrderItems CustomerOrderItem[] @relation("CustomerOrderItems")

  @@unique([supplierOrgId, sku])
  @@index([status, categoryId])
  @@index([supplierOrgId, status])
}

model ProductCompatibility {
  id         String  @id @default(cuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  make       String
  model      String?
  yearFrom   Int?
  yearTo     Int?
  engine     String? // engine configuration where applicable
  trim       String?
  chassis    String? // VIN-prefix / chassis code
  source     String  @default("SUPPLIER") // SUPPLIER | ADMIN
  verified   Boolean @default(false) // admin-reviewed fitment
  note       String?

  @@index([productId])
  @@index([make, model])
}

model ProductStock {
  id           String  @id @default(cuid())
  productId    String
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  branchId     String
  branch       OrgBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  qtyOnHand    Int     @default(0)
  qtyReserved  Int     @default(0) // reserved by open orders — prevents overselling
  reorderLevel Int     @default(0)

  @@unique([productId, branchId])
  @@index([branchId])
}

model StockMovement {
  id        String    @id @default(cuid())
  branchId  String
  branch    OrgBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  productId String
  delta     Int       // +in / -out
  reason    String    // RESTOCK|SALE|RESERVE|RELEASE|TRANSFER_OUT|TRANSFER_IN|ADJUST|RETURN|DISPUTE_WRITEOFF
  refType   String?   // PURCHASE_ORDER | STOCK_TRANSFER | MANUAL
  refId     String?
  note      String?
  actorId   String?
  actorName String?
  createdAt DateTime  @default(now())

  @@index([productId, createdAt])
  @@index([branchId, createdAt])
}

model ProductPriceHistory {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceMinor Int
  reason     String   // LIST | UPDATE | PROMO
  createdAt  DateTime @default(now())

  @@index([productId, createdAt])
}

model ProductReview {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  rating    Int      // 1..5
  comment   String?
  verifiedPurchase Boolean @default(false) // linked to a completed PO item
  refOrderId String?
  createdAt DateTime @default(now())

  @@unique([productId, authorId])
}

// ───────────────────── Purchase orders (garage ⇄ supplier) ─────────────────────

model PurchaseOrder {
  id                String   @id @default(cuid())
  refCode           String   @unique
  garageOrgId       String
  garage            Org      @relation("POGarage", fields: [garageOrgId], references: [id], onDelete: Cascade)
  supplierOrgId     String
  supplier          Org      @relation("POSupplier", fields: [supplierOrgId], references: [id])
  destinationBranchId String? // garage branch receiving the delivery
  destinationBranch OrgBranch? @relation("PODestinationBranch", fields: [destinationBranchId], references: [id])
  createdById       String
  createdBy         User     @relation("POAuthor", fields: [createdById], references: [id])
  status            String   @default("SUBMITTED")
  // SUBMITTED | AWAITING_APPROVAL | ACCEPTED | REVISED | REJECTED | CONFIRMED
  // | DISPATCHED | IN_TRANSIT | DELIVERED | INSPECTED | COMPLETED | CANCELLED | DISPUTED
  // (AWAITING_APPROVAL = garage-internal approval gate above spending limit)
  paymentStatus     String   @default("UNPAID") // UNPAID | PROCESSING | PROTECTED | RELEASED | PARTIALLY_RELEASED | REFUNDED | FAILED
  inspectionStatus  String?  // ACCEPTED | PARTIAL | ISSUES (set at inspection)
  subtotalMinor     Int      @default(0)
  deliveryFeeMinor  Int      @default(0)
  taxMinor          Int      @default(0)
  platformFeeMinor  Int      @default(0) // commission recorded separately at release
  totalMinor        Int      @default(0)
  acceptedTotalMinor Int?    // total after inspection acceptance (partial acceptance)
  currency          String   @default("KES")
  supplierNote      String?  // supplier response note (accept/reject/revise)
  revisedBySupplier Boolean  @default(false)
  garageApprovedRevision Boolean @default(false)
  deliveryMethod    String?  // DIRECT | COLLECTION | MEETUP (set at arrangement, both parties agree)
  invoiceId         String?  // platform invoice for the order payment
  deliveryOtpHash   String?  // bcrypt hash of handover OTP
  commissionRatePct Float?   // snapshot of commission rate applied
  cancelledReason   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  items        POItem[]
  revisions    PORevision[]
  delivery     Delivery?
  payment      PaymentAuthorization?
  refunds      Refund[]
  disputes     Dispute[]
  events       POEvent[]
  settlements  Settlement[] @relation("OrderSettlements")

  @@index([garageOrgId, status])
  @@index([supplierOrgId, status])
}

model POItem {
  id            String   @id @default(cuid())
  orderId       String
  order         PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String
  product       Product  @relation(fields: [productId], references: [id])
  qty           Int
  unitPriceMinor Int     // agreed unit price (garage-approved)
  lineTotalMinor Int
  fulfilBranchId String? // supplier warehouse reserved for this line (overselling guard)
  qtyAccepted   Int?     // set at inspection
  qtyDelivered  Int?
  note          String?  // e.g. issue reported at inspection
  batchNo       String?
  serialNo      String?

  @@index([orderId])
  @@index([productId])
}

model PORevision {
  id          String   @id @default(cuid())
  orderId     String
  order       PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  proposedBy  String   // SUPPLIER
  changesJson String   // JSON [{itemId?, productId, qty, unitPriceMinor, action: UPDATE|REMOVE|ADD}]
  newTotalMinor Int
  note        String?
  status      String   @default("PENDING") // PENDING | APPROVED | DECLINED (garage decision)
  createdAt   DateTime @default(now())

  @@index([orderId, status])
}

model POEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String   // CREATED|SUBMITTED|APPROVED|ACCEPTED|REVISED|REVISION_DECISION|CONFIRMED|PAYMENT|DISPATCH|DELIVERED|INSPECTED|RELEASED|COMPLETED|CANCELLED|NOTE
  actorId   String?
  actorName String
  actorSide String   // GARAGE | SUPPLIER | SYSTEM | ADMIN
  note      String?
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

// ───────────────────────── Deliveries & logistics ─────────────────────────

model Delivery {
  id                String   @id @default(cuid())
  refCode           String   @unique
  orderId           String   @unique
  order             PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method            String   // DIRECT | COLLECTION | MEETUP
  status            String   @default("ARRANGING")
  // ARRANGING | AGREED | DISPATCHED | IN_TRANSIT | DELIVERED | FAILED | CANCELLED | RETURN_PICKUP
  supplierBranchId  String?
  supplierBranch    OrgBranch? @relation("DeliverySupplierBranch", fields: [supplierBranchId], references: [id])
  meetupJson        String?  // JSON {lat,lng,address} — mutually agreed handover location
  meetupAgreedByGarage   Boolean @default(false)
  meetupAgreedBySupplier Boolean @default(false)
  scheduledFor      DateTime?
  windowLabel       String?  // e.g. "Morning (08:00–12:00)"
  courierName       String?  // supplier-owned | third-party courier name
  driverName        String?
  driverPhone       String?
  vehicleReg        String?
  deliveryRef       String?
  dispatchEvidence  String?  // JSON string[] of evidence urls
  dispatchedAt      DateTime?
  expectedAt        DateTime?
  otpHash           String?  // bcrypt hash of 6-digit handover OTP
  otpHint           String?  // last 2 digits for UX
  qrToken           String?  @unique
  deliveredAt       DateTime?
  handoverJson      String?  // JSON {garageConfirmedAt, supplierConfirmedAt, captureLocation, location, photos[]}
  garageConfirmAt   DateTime?
  supplierConfirmAt DateTime?
  failedReason      String?
  feeMinor          Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  events DeliveryEvent[]

  @@index([status])
}

model DeliveryEvent {
  id         String   @id @default(cuid())
  deliveryId String
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  type       String   // ARRANGED|LOCATION_PROPOSED|LOCATION_AGREED|DISPATCHED|IN_TRANSIT|DELIVERED|FAILED|CANCELLED|NOTE
  actorId    String?
  actorName  String
  actorSide  String   // GARAGE | SUPPLIER | SYSTEM
  note       String?
  createdAt  DateTime @default(now())

  @@index([deliveryId, createdAt])
}

// ───────────────── Protected payments, refunds, disputes ─────────────────

model PaymentAuthorization {
  id             String   @id @default(cuid())
  refCode        String   @unique
  orderId        String   @unique
  order          PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider       String   @default("MPESA_DARAJA") // MPESA_DARAJA | MANUAL_RECONCILED
  // PROTECTED is set ONLY on provider confirmation (Daraja callback / staff reconciliation).
  // A dispatch confirmation alone can never set it.
  status         String   @default("PENDING") // PENDING | PROCESSING | PROTECTED | RELEASED | PARTIALLY_RELEASED | REFUNDED | FAILED | CANCELLED
  amountMinor    Int
  currency       String   @default("KES")
  checkoutRef    String?  @unique // provider transaction reference (CheckoutRequestID)
  phone          String?
  resultDesc     String?
  webhookEvents  String?  // JSON string[] of processed webhook event keys (idempotency)
  protectedAt    DateTime?
  releasedAmountMinor Int  @default(0)
  refundedAmountMinor Int  @default(0)
  releasedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
}

model Refund {
  id             String   @id @default(cuid())
  refCode        String   @unique
  orderId        String
  order          PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentAuthId  String?
  amountMinor    Int
  kind           String   // FULL | PARTIAL
  reason         String
  status         String   @default("REQUESTED") // REQUESTED | APPROVED | PROCESSED | REJECTED
  requestedById  String?
  processedBy    String?  // admin actor name
  processedAt    DateTime?
  providerRef    String?
  createdAt      DateTime @default(now())

  @@index([orderId])
}

// ── Supplier settlements ─────────────────────────────────────────────────
// Auditable payout ledger for released protected payments. A settlement is
// CREATED (PENDING) when a purchase order payment is RELEASED to the
// supplier's benefit; it becomes SETTLED only when a payout provider confirms
// the transfer or FINANCE records a manual reconciliation with a reference.
// No code path ever marks money as moved without that confirmation.

model Settlement {
  id               String    @id @default(cuid())
  refCode          String    @unique
  orgId            String
  org              Org       @relation("SupplierSettlements", fields: [orgId], references: [id], onDelete: Cascade)
  orderId          String?
  order            PurchaseOrder? @relation("OrderSettlements", fields: [orderId], references: [id], onDelete: SetNull)
  kind             String    @default("PO_RELEASE") // PO_RELEASE | REFUND_ADJUSTMENT | MANUAL
  amountMinor      Int       // released gross amount this settlement covers
  commissionMinor  Int       @default(0) // platform commission deducted
  netMinor         Int       // amount owed to supplier = amountMinor - commissionMinor
  currency         String    @default("KES")
  status           String    @default("PENDING") // PENDING | PROCESSING | SETTLED | FAILED | ON_HOLD | CANCELLED
  provider         String?   // MPESA_B2C | MANUAL
  providerRef      String?   // provider conversation/receipt reference
  attempts         Int       @default(0)
  lastError        String?
  holdReason       String?
  reconciledById   String?
  reconciledByName String?
  reconciledNote   String?
  settledAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  events           SettlementEvent[]

  @@index([orgId, status])
  @@index([status, createdAt])
  @@index([orderId])
}

model SettlementEvent {
  id           String     @id @default(cuid())
  settlementId String
  settlement   Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  type         String     // CREATED | PAYOUT_ATTEMPT | SETTLED | FAILED | HOLD | HOLD_RELEASED | CANCELLED | NOTE
  actorId      String?
  actorName    String?
  actorSide    String     @default("SYSTEM") // SYSTEM | FINANCE | ADMIN | SUPPLIER
  note         String?
  createdAt    DateTime   @default(now())

  @@index([settlementId, createdAt])
}

model Dispute {
  id             String   @id @default(cuid())
  refCode        String   @unique
  orderId        String?
  order          PurchaseOrder? @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Disputes can also be opened by consumers on their B2C parts orders.
  customerOrderId String?
  customerOrder  CustomerOrder? @relation("CustomerOrderDisputes", fields: [customerOrderId], references: [id], onDelete: Cascade)
  openedById     String
  openedBySide   String   // GARAGE | SUPPLIER | CUSTOMER
  reason         String   // MISSING_ITEMS|DAMAGED|WRONG_ITEM|COUNTERFEIT|NOT_RECEIVED|OTHER
  details        String
  evidence       String?  // JSON [{url,name,uploadedAt}]
  amountFrozenMinor Int?  // disputed amount frozen where provider supports it
  status         String   @default("OPEN") // OPEN | UNDER_REVIEW | RESOLVED | CLOSED
  resolution     String?  // REFUND_FULL | REFUND_PARTIAL | REPLACEMENT | REJECTED
  resolutionNote String?
  resolvedBy     String?
  resolvedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  events DisputeEvent[]

  @@index([status])
}

model DisputeEvent {
  id        String   @id @default(cuid())
  disputeId String
  dispute   Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  type      String   // CREATED|NOTE|EVIDENCE|STATUS_CHANGE|RESOLUTION
  actorId   String?
  actorName String
  note      String?
  createdAt DateTime @default(now())

  @@index([disputeId, createdAt])
}

model WarrantyClaim {
  id           String   @id @default(cuid())
  refCode      String   @unique
  orderId      String?
  productId    String
  garageOrgId  String
  supplierOrgId String
  issue        String
  status       String   @default("OPEN") // OPEN | APPROVED | REJECTED | RESOLVED
  resolution   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([supplierOrgId, status])
}

model PartReturn {
  id          String   @id @default(cuid())
  refCode     String   @unique
  orderId     String
  reason      String
  itemsJson   String   // JSON [{productId, qty}]
  status      String   @default("REQUESTED") // REQUESTED | APPROVED | REJECTED | PICKUP_SCHEDULED | COMPLETED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orderId])
}

// ───────────────── Request-a-part quotations (garage → suppliers) ─────────────────

model QuoteRequest {
  refCode      String   @unique
  id           String   @id @default(cuid())
  garageOrgId  String
  createdById  String
  createdBy    User     @relation("QuoteReqAuthor", fields: [createdById], references: [id])
  title        String
  description  String
  partNumber   String?
  photoUrl     String?
  vehicleJson  String?  // JSON {make, model, year, engine, trim}
  budgetMinor  Int?
  deliveryCounty String?
  status       String   @default("OPEN") // OPEN | QUOTING | CLOSED
  expiresAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  offers QuoteOffer[]

  @@index([garageOrgId, status])
}

model QuoteOffer {
  id            String  @id @default(cuid())
  requestId     String
  request       QuoteRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  supplierOrgId String
  supplier      Org     @relation(fields: [supplierOrgId], references: [id], onDelete: Cascade)
  amountMinor   Int
  leadDays      Int?
  note          String?
  itemsJson     String? // JSON [{name, partNumber, qty, unitPriceMinor}]
  status        String  @default("PENDING") // PENDING | ACCEPTED | DECLINED | WITHDRAWN
  createdAt     DateTime @default(now())

  @@unique([requestId, supplierOrgId])
  @@index([supplierOrgId, status])
}

// ───────────── Business memberships (garage/showroom customer programmes) ─────────────

model MembershipTier {
  id                 String  @id @default(cuid())
  orgId              String
  org                Org     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name               String
  description        String?
  priceMonthlyMinor  Int
  priceYearlyMinor   Int?
  benefits           String  // JSON string[] of benefit statements
  memberLimit        Int?    // null = unlimited
  discountCapPct     Int?    // max discount offered, transparency
  branchScope        String  @default("ALL") // ALL | SELECTED
  branchesJson       String? // JSON string[] of branch ids when SELECTED
  terms              String?
  active             Boolean @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  memberships BusinessMembership[]

  @@index([orgId, active])
}

model BusinessMembership {
  id             String   @id @default(cuid())
  refCode        String   @unique
  tierId         String
  tier           MembershipTier @relation(fields: [tierId], references: [id], onDelete: Cascade)
  orgId          String   // participating business (denormalised for tenancy checks)
  org            Org      @relation("MembershipOrg", fields: [orgId], references: [id])
  customerId     String
  customer       User     @relation("MembershipCustomer", fields: [customerId], references: [id])
  billingPeriod  String   // MONTHLY | YEARLY
  status         String   @default("PENDING_PAYMENT") // PENDING_PAYMENT | ACTIVE | CANCELLED | EXPIRED
  startedAt      DateTime?
  currentPeriodEnd DateTime?
  cancelledAt    DateTime?
  invoiceId      String?
  invoice        Invoice? @relation(fields: [invoiceId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  redemptions MembershipRedemption[]

  @@index([customerId, status])
  @@index([orgId, status])
}

model MembershipRedemption {
  id           String   @id @default(cuid())
  membershipId String
  membership   BusinessMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  benefit      String
  periodKey    String   // e.g. "2025-11" — one redemption per benefit per period
  refType      String?
  refId        String?
  createdAt    DateTime @default(now())

  @@unique([membershipId, benefit, periodKey])
}

// ───────────── Trusted Customer Programme (business-private) ─────────────

model TrustProgramme {
  id          String  @id @default(cuid())
  orgId       String
  org         Org     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name        String
  description String?
  terms       String?
  status      String  @default("ACTIVE") // ACTIVE | PAUSED
  createdAt   DateTime @default(now())

  members TrustMember[]

  @@unique([orgId])
}

model TrustMember {
  id              String   @id @default(cuid())
  programmeId     String
  programme       TrustProgramme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  customerId      String
  customer        User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  // Internal business relationship label — NOT a universal credit rating and
  // never shared with other businesses.
  label           String   @default("NEW") // NEW|REGULAR|LOYAL|PREFERRED|TRUSTED|SUSPENDED
  invitedById     String?
  approvedAt      DateTime?
  termsAcceptedAt DateTime?
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([programmeId, customerId])
}

// ───────────── Business-controlled customer credit ledger ─────────────
// Management technology only — the platform is not a lender. Each business
// independently approves its own customers; approval never transfers between
// businesses and is never granted because of a membership purchase.

model CreditFacility {
  id              String   @id @default(cuid())
  refCode         String   @unique
  orgId           String   // issuing business
  org             Org      @relation("CreditIssuer", fields: [orgId], references: [id], onDelete: Cascade)
  customerId      String
  customer        User     @relation("CreditCustomer", fields: [customerId], references: [id])
  limitMinor      Int
  depositMinor    Int      @default(0)
  status          String   @default("PENDING") // PENDING_APPLICATION | OFFERED | ACTIVE | SUSPENDED | CLOSED | REJECTED
  terms           String?  // repayment terms text agreed by customer
  approvedAt      DateTime?
  termsAcceptedAt DateTime?
  closedAt        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  entries CreditEntry[]

  @@unique([orgId, customerId])
}

model CreditEntry {
  id                String   @id @default(cuid())
  facilityId        String
  facility          CreditFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  kind              String   // CHARGE | REPAYMENT | FEE | ADJUSTMENT
  amountMinor       Int      // CHARGE/FEE positive (increases balance), REPAYMENT negative
  balanceAfterMinor Int
  refType           String?  // e.g. BOOKING, SERVICE
  refId             String?
  dueDate           DateTime?
  paidAt            DateTime?
  note              String?
  actorId           String?
  actorName         String?
  createdAt         DateTime @default(now())

  @@index([facilityId, createdAt])
}

// ───────────── Inter-branch vehicle transfers (showrooms) ─────────────

model VehicleTransfer {
  id              String   @id @default(cuid())
  refCode         String   @unique
  orgId           String   // owning company
  org             Org      @relation("TransferOwner", fields: [orgId], references: [id], onDelete: Cascade)
  vehicleId       String
  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id])
  fromBranchId    String
  fromBranch      OrgBranch @relation("TransferFromBranch", fields: [fromBranchId], references: [id])
  toBranchId      String
  toBranch        OrgBranch @relation("TransferToBranch", fields: [toBranchId], references: [id])
  status          String   @default("REQUESTED") // REQUESTED | APPROVED | DISPATCHED | RECEIVED | CANCELLED | REJECTED
  conditionOutJson String? // JSON departure condition report {odometer, notes, photos[]}
  conditionInJson  String? // JSON receipt condition report
  dispatchRef     String?
  requestedById   String?
  approvedById    String?
  receivedByName  String?
  dispatchedAt    DateTime?
  receivedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  events VehicleTransferEvent[]

  @@index([orgId, status])
}

model VehicleTransferEvent {
  id          String   @id @default(cuid())
  transferId  String
  transfer    VehicleTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  type        String   // REQUESTED|APPROVED|DISPATCHED|RECEIVED|CANCELLED|REJECTED|NOTE
  actorId     String?
  actorName   String
  note        String?
  createdAt   DateTime @default(now())

  @@index([transferId, createdAt])
}

// ───────────── Procurement intelligence ─────────────

model GarageStockAlert {
  id         String  @id @default(cuid())
  garageOrgId String
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  minQty     Int     @default(1)
  active     Boolean @default(true)
  createdAt  DateTime @default(now())

  @@unique([garageOrgId, productId])
}

model SavedSupplyItem {
  id         String  @id @default(cuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType String  // SUPPLIER | PRODUCT
  targetId   String
  createdAt  DateTime @default(now())

  @@unique([userId, targetType, targetId])
  @@index([userId])
}

// ───────────── Document verification engine ─────────────
// Every uploaded verification document lives here with an explicit state
// machine. Uploading NEVER grants verified status — only a staff reviewer
// decision (with note, time and actor recorded) moves a document to VERIFIED.

model VerificationDocument {
  id             String       @id @default(cuid())
  refCode        String       @unique
  ownerUserId    String
  owner          User         @relation("DocumentOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  orgId          String?
  org            Org?         @relation("DocumentOrg", fields: [orgId], references: [id], onDelete: SetNull)
  applicationId  String?
  application    Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  kind           String  // ID_FRONT | ID_BACK | PASSPORT | PIN_CERTIFICATE | BUSINESS_LICENSE | DIRECTOR_ID | LOGBOOK | OWNERSHIP_AUTH | DRIVER_LICENSE | INSURANCE | VEHICLE_REG | REGISTRATION_CERT | SUPPORTING | OTHER
  label          String?
  fileUrl        String  // /api/files/<name> — private, permissioned
  fileName       String
  // SUBMITTED | UNDER_REVIEW | MORE_INFO_REQUIRED | VERIFIED | REJECTED | EXPIRED | SUPERSEDED
  status         String       @default("SUBMITTED")
  reviewNote     String?
  reviewedById   String?
  reviewedByName String?
  reviewedAt     DateTime?
  infoRequestedAt DateTime?
  correctionsDueAt DateTime?
  expiresAt      DateTime?
  supersededById String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  accessLogs     DocumentAccessLog[]

  @@index([ownerUserId, status])
  @@index([orgId, status])
  @@index([applicationId])
  @@index([status, createdAt])
}

model DocumentAccessLog {
  id         String                @id @default(cuid())
  documentId String
  document   VerificationDocument  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  viewerId   String
  viewerName String
  action     String  // VIEWED | DOWNLOADED | STATUS_CHANGE
  createdAt  DateTime @default(now())

  @@index([documentId, createdAt])
}

// ───────────── Consumer parts ordering (Customer Platform) ─────────────
// Customers order products directly from verified suppliers. Deliberately
// separate from the B2B PurchaseOrder system: simpler lifecycle, buyer is a
// user (not an org), payment follows the same honest invoice rules.

model CustomerOrder {
  id               String   @id @default(cuid())
  refCode          String   @unique
  buyerUserId      String
  buyer            User     @relation("CustomerOrderBuyer", fields: [buyerUserId], references: [id], onDelete: Cascade)
  supplierOrgId    String
  supplier         Org      @relation("CustomerOrderSupplier", fields: [supplierOrgId], references: [id], onDelete: Cascade)
  // SUBMITTED | ACCEPTED | REJECTED | CONFIRMED | DISPATCHED | DELIVERED | COMPLETED | CANCELLED | DISPUTED
  status           String   @default("SUBMITTED")
  county           String
  address          String
  phone            String
  notes            String?
  deliveryMethod   String   @default("DIRECT") // DIRECT | COLLECTION
  deliveryFeeMinor Int      @default(0)
  totalMinor       Int      @default(0)
  currency         String   @default("KES")
  paymentStatus    String   @default("UNPAID") // UNPAID | PROCESSING | PAID | REFUNDED
  invoiceId        String?
  invoice          Invoice? @relation("CustomerOrderInvoice", fields: [invoiceId], references: [id])
  otpHash          String?
  otpHint          String?
  courierName      String?
  fulfillmentBranchId String?
  rejectedReason   String?
  deliveredAt      DateTime?
  completedAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  items  CustomerOrderItem[]
  events CustomerOrderEvent[]
  disputes Dispute[] @relation("CustomerOrderDisputes")

  @@index([buyerUserId, status])
  @@index([supplierOrgId, status])
}

model CustomerOrderItem {
  id             String        @id @default(cuid())
  orderId        String
  order          CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product       @relation("CustomerOrderItems", fields: [productId], references: [id])
  qty            Int
  unitPriceMinor Int
  lineTotalMinor Int

  @@index([orderId])
}

model CustomerOrderEvent {
  id        String        @id @default(cuid())
  orderId   String
  order     CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String // CREATED | ACCEPTED | REJECTED | CONFIRMED | DISPATCHED | DELIVERED | COMPLETED | CANCELLED | NOTE | PAYMENT
  actorSide String // CUSTOMER | SUPPLIER | SYSTEM
  actorId   String?
  actorName String
  note      String?
  createdAt DateTime      @default(now())

  @@index([orderId, createdAt])
}

// ───────────────────── Uploads ─────────────────────

// Metadata for every file accepted by POST /api/upload. The file bytes live on
// disk (data/uploads[/media]); this record carries ownership, purpose and
// visibility so uploads are auditable, user-listable and cleanable.
model UploadRecord {
  id          String   @id @default(cuid())
  ownerUserId String
  owner       User     @relation("UploadOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  fileName    String   @unique // server-generated <userId>.<16hex>.<ext> — matches both serving routes
  url         String   // /api/media/<name> (PUBLIC) or /api/files/<name> (PRIVATE)
  kind        String   // IMAGE | DOCUMENT
  visibility  String   // PUBLIC | PRIVATE
  mimeType    String   // verified actual (magic-byte) type, never the client-declared one
  sizeBytes   Int
  purpose     String?  // optional free text from the uploading flow (truncated)
  createdAt   DateTime @default(now())

  @@index([ownerUserId, createdAt])
  @@index([visibility, createdAt])
}
