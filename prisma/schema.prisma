// CARMAZE — Automotive ecosystem schema (SQLite / Prisma)
// Money is stored as integer minor units (cents) with explicit currency (default KES).
// SQLite has no enums/arrays/JSON: use String fields (JSON stored as strings).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Users & access ─────────────────────────────

// Server-side registry of the public demo experiences shown on the Sign In
// page. Credentials are NEVER sent to the frontend: the demo sign-in endpoint
// maps a roleKey to its seeded account entirely server-side.
model DemoAccount {
  id             String   @id @default(cuid())
  roleKey        String   @unique // customer | private-seller | showroom-owner | showroom-staff | garage-owner | garage-staff | platform-support | platform-admin
  email          String   // demo user account this role signs in as (server-side only)
  label          String
  description    String
  dashboard      String   // hash route opened after demo sign-in
  enabled        Boolean  @default(true)
  sessionMinutes Int      @default(20160) // demo session lifetime (2 weeks; cap 14 days)
  restrictedNote String?  // shown in the UI, e.g. admin demo restriction
  lastResetAt    DateTime?
  resetCount     Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String
  phone         String?
  phoneVerified Boolean  @default(false)
  phoneCode     String?
  phoneCodeExpiresAt DateTime? // verification codes always expire
  phoneCodeAttempts  Int       @default(0)  // confirm-attempt counter (cleared on success/new request)
  emailVerified Boolean  @default(false)
  emailCode     String?  // one-time email verification code (honest dev fallback when SMTP unconfigured)
  emailCodeExpiresAt DateTime? // verification codes always expire
  emailCodeAttempts  Int       @default(0)  // confirm-attempt counter (cleared on success/new request)
  roles         String   @default("CUSTOMER") // comma separated: CUSTOMER,SELLER,SELLER_VERIFIED,DEALER_OWNER,DEALER_STAFF,GARAGE_OWNER,GARAGE_STAFF,SUPPLIER_OWNER,SUPPLIER_STAFF,LOGISTICS_OWNER,FINANCE,SUPPORT,REVIEWER,MODERATOR,ADMIN,FOUNDER
  department    String?  // company staff department (BUSINESS_VERIFICATION|SUPPORT|FINANCE|DISPUTES|FRAUD|MODERATION|TECHNICAL)
  totpSecret    String?  // base32 TOTP secret for MFA (null = MFA disabled)
  mfaEnabled    Boolean  @default(false)
  isDemo        Boolean  @default(false) // demo-experience account: sandboxed from real users/orgs, excluded from real notifications & payments
  marketingConsent Boolean @default(true) // DPA: marketing-consent flag withdrawn via privacy delete-request (scope MARKETING_ONLY)
  status        String   @default("ACTIVE") // ACTIVE | SUSPENDED
  sessionVersion Int     @default(0) // bumped on password reset / MFA disable → all existing session JWTs invalid
  referralCode  String?  @unique // this user's own shareable referral code
  referredById  String?  // user who referred them (attribution — set once at registration)
  referredAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  vehicles         Vehicle[]        @relation("VehicleOwner")
  enquiries        Enquiry[]
  serviceRequests  ServiceRequest[]
  roadsideRequests RoadsideRequest[]
  myVehicles       MyVehicle[]
  posts            CommunityPost[]
  comments         PostComment[]
  reactions        PostReaction[]
  reports          Report[]         @relation("Reporter")
  notifications    Notification[]
  applications     Application[]
  reviews          OrgReview[]
  savedVehicles    SavedVehicle[]
  savedSearches    SavedSearch[]
  orgMemberships   OrgMember[]
  follows          Follow[]         @relation("Follower")
  followings       Follow[]         @relation("Following")
  conversations    Conversation[]   @relation("Conversations")
  custodies        VehicleCustody[] @relation("Custodies")
  testDrives       TestDrive[]      @relation("TestDrives")
  incidents        SecurityIncident[] @relation("Incidents")
  loyaltyEntries   LoyaltyLedger[]

  // ── Supply network & business programmes ──
  businessMemberships BusinessMembership[] @relation("MembershipCustomer")
  trustMemberships    TrustMember[]
  productReviews      ProductReview[]
  savedSupplyItems    SavedSupplyItem[]
  creditFacilities    CreditFacility[]     @relation("CreditCustomer")
  authoredPOs         PurchaseOrder[]      @relation("POAuthor")
  authoredRequests    QuoteRequest[]       @relation("QuoteReqAuthor")
  customerOrders      CustomerOrder[]      @relation("CustomerOrderBuyer")
  verificationDocuments VerificationDocument[] @relation("DocumentOwner")

  // ── Identity & security ──
  passwordResetTokens PasswordResetToken[]

  // ── Logistics network ──
  ownedLogisticsPartner LogisticsPartner?
  deliveryJobsRequested DeliveryJob[]       @relation("DeliveryJobRequester")

  // ── Uploads ──
  uploads UploadRecord[] @relation("UploadOwner")
}

// ───────────────────── Identity & security ─────────────────────

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique // sha256(token) — the raw token is never stored
  expiresAt DateTime
  usedAt    DateTime?
  requestIp String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ───────────────────── Logistics & delivery partners ─────────────────────

model LogisticsPartner {
  id             String   @id @default(cuid())
  refCode        String   @unique
  ownerUserId    String   @unique // one partner per owner account
  owner          User     @relation(fields: [ownerUserId], references: [id])
  name           String
  partnerType    String   @default("COMPANY") // COMPANY | INDEPENDENT
  regNo          String?
  county         String
  town           String?
  phone          String
  email          String?
  representative String
  serviceAreas   String?  // JSON string[] — counties served
  capabilities   String?  // JSON string[] — PARCELS|VEHICLES|TOWING|PARTS
  documents      String?  // JSON [{name,url,uploadedAt}]
  consent        Boolean  @default(false)
  status         String   @default("PENDING") // PENDING|UNDER_REVIEW|MORE_INFO_REQUIRED|APPROVED|REJECTED|SUSPENDED
  verified       Boolean  @default(false) // set ONLY by staff review — never self-claimed
  decisionNote   String?
  appliedAt      DateTime?
  reviewedAt     DateTime?
  reviewedByName String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  drivers Driver[]
  jobs    DeliveryJob[]
  events  LogisticsPartnerEvent[]

  @@index([status])
}

model LogisticsPartnerEvent {
  id        String            @id @default(cuid())
  partnerId String
  partner   LogisticsPartner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  type      String // SUBMITTED|APPROVED|REJECTED|SUSPENDED|REINSTATED|INFO_REQUESTED|NOTE
  actorId   String?
  actorName String?
  note      String?
  createdAt DateTime          @default(now())

  @@index([partnerId, createdAt])
}

model Driver {
  id          String            @id @default(cuid())
  partnerId   String
  partner     LogisticsPartner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  name        String
  phone       String
  licenseNo   String?
  vehicleReg  String?
  vehicleType String? // MOTORBIKE|PICKUP|VAN|TRUCK|TOW_TRUCK
  status      String   @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt   DateTime @default(now())

  jobs DeliveryJob[]

  @@index([partnerId])
}

model DeliveryJob {
  id                 String            @id @default(cuid())
  refCode            String            @unique
  requestedByUserId  String
  requester          User              @relation("DeliveryJobRequester", fields: [requestedByUserId], references: [id])
  requesterOrgId     String? // when requested on behalf of a business (garage/showroom/supplier)
  requesterOrgName   String?
  partnerId          String? // assigned logistics partner
  partner            LogisticsPartner? @relation(fields: [partnerId], references: [id])
  driverId           String?
  driver             Driver?           @relation(fields: [driverId], references: [id])
  cargoDesc          String
  sizeClass          String   @default("SMALL") // SMALL|MEDIUM|LARGE
  pickupCounty       String
  pickupAddress      String
  pickupContactName  String
  pickupContactPhone String
  dropCounty         String
  dropAddress        String
  dropContactName    String
  dropContactPhone   String
  status             String   @default("OPEN") // OPEN|ASSIGNED|PICKED_UP|IN_TRANSIT|DELIVERED|FAILED|CANCELLED
  feeMinor           Int      @default(0) // quoted by the partner at acceptance
  otpHash            String? // bcrypt hash of the drop-off handover OTP
  otpHint            String? // last 2 digits for UX
  qrToken            String? @unique // requester-side QR alternative to the OTP
  podPhotos          String? // JSON string[] — proof-of-delivery evidence
  failReason         String?
  pickupAt           DateTime?
  deliveredAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  events DeliveryJobEvent[]

  @@index([status, createdAt])
  @@index([requestedByUserId])
  @@index([partnerId])
}

model DeliveryJobEvent {
  id        String      @id @default(cuid())
  jobId     String
  job       DeliveryJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  type      String // CREATED|ASSIGNED|ACCEPTED|DECLINED|PICKED_UP|IN_TRANSIT|DELIVERED|FAILED|CANCELLED|NOTE
  actorId   String?
  actorName String
  actorSide String // CUSTOMER | PARTNER | STAFF | SYSTEM
  note      String?
  createdAt DateTime    @default(now())

  @@index([jobId, createdAt])
}

// ───────────────────── Unified messaging (customer ⇄ business) ─────────────────────

model Conversation {
  id                 String   @id @default(cuid())
  orgId              String
  org                Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customerId         String
  customer           User     @relation("Conversations", fields: [customerId], references: [id])
  subject            String? // e.g. "Accident repair — KDJ 345K"
  vehicleId          String? // optional vehicle listing reference
  vehicle            Vehicle? @relation(fields: [vehicleId], references: [id])
  serviceId          String? // optional garage service reference
  kind               String   @default("GENERAL") // GENERAL|QUOTE|BOOKING|VEHICLE_ENQUIRY|SUPPORT
  status             String   @default("OPEN") // OPEN|CLOSED
  lastMessageAt      DateTime @default(now())
  lastMessagePreview String?
  unreadForOrg       Boolean  @default(false)
  unreadForCustomer  Boolean  @default(false)
  orgArchived        Boolean  @default(false)
  customerArchived   Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  messages ConversationMessage[]

  @@index([orgId, lastMessageAt])
  @@index([customerId, lastMessageAt])
}

model ConversationMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String? // null → system note
  senderName     String
  senderSide     String // CUSTOMER|ORG|SYSTEM
  body           String
  attachments    String? // JSON string[] of attachment urls
  refType        String? // QUOTE|BOOKING|SERVICE_REQUEST|VEHICLE
  refId          String?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

// ───────────── Garage Vehicle Protection — custody / handover ─────────────

model VehicleCustody {
  id                   String    @id @default(cuid())
  refCode              String    @unique
  orgId                String
  org                  Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customerId           String
  customer             User      @relation("Custodies", fields: [customerId], references: [id])
  myVehicleId          String?   // link to a My Garage vehicle record
  vehicleDesc          String    // "Toyota Prado 2018, KDJ 345K"
  plate                String?
  odometerKm           Int?
  fuelLevel            String?   // E|QUARTER|HALF|THREE_QUARTER|FULL
  conditionNotes       String?   // existing damage declared by customer
  photos               String?   // JSON string[] — drop-off condition evidence
  valuables            String?   // declared personal property left inside
  requestedWork        String
  authorisedSpendMinor Int?      // agreed spending cap
  roadTestAllowed      Boolean   @default(false)
  status               String    @default("HANDOVER_REQUESTED")
  // HANDOVER_REQUESTED|RECEIVED|INSPECTION|AWAITING_APPROVAL|WORK_IN_PROGRESS|ROAD_TEST_REQUESTED|READY_FOR_COLLECTION|COLLECTION_PENDING|RETURNED|DISPUTED|INCIDENT
  receivedAt           DateTime?
  receivedByStaffName  String?
  readyAt              DateTime?
  completedWork        String?
  finalOdometerKm      Int?
  finalNotes           String?
  completionPhotos     String?   // JSON string[]
  costMinor            Int?
  collectedAt          DateTime?
  collectedByName      String?
  returnedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  events       CustodyEvent[]
  roadTests    RoadTest[]
  collectionAuth CollectionAuthorisation?

  @@index([orgId, status])
  @@index([customerId, status])
}

model CustodyEvent {
  id         String         @id @default(cuid())
  custodyId  String
  custody    VehicleCustody @relation(fields: [custodyId], references: [id], onDelete: Cascade)
  type       String // STATUS_CHANGE|NOTE|ROAD_TEST|DISPUTE|INCIDENT|HANDOVER|COLLECTION
  fromStatus String?
  toStatus   String?
  actorId    String?
  actorName  String
  actorSide  String // CUSTOMER|ORG|SYSTEM
  note       String?
  createdAt  DateTime       @default(now())

  @@index([custodyId, createdAt])
}

model RoadTest {
  id              String         @id @default(cuid())
  custodyId       String
  custody         VehicleCustody @relation(fields: [custodyId], references: [id], onDelete: Cascade)
  purpose         String
  driverName      String
  startOdometerKm Int?
  endOdometerKm   Int?
  requestedAt     DateTime       @default(now())
  authorisedAt    DateTime? // customer approval
  startedAt       DateTime?
  endedAt         DateTime?
  status          String         @default("REQUESTED") // REQUESTED|AUTHORISED|IN_PROGRESS|COMPLETED|DECLINED
  notes           String?
  incident        Boolean        @default(false)

  @@index([custodyId])
}

model CollectionAuthorisation {
  id             String         @id @default(cuid())
  custodyId      String         @unique
  custody        VehicleCustody @relation(fields: [custodyId], references: [id], onDelete: Cascade)
  collectorName  String
  collectorPhone String
  authCodeHash   String // bcrypt hash of the single-use code
  codeHint       String? // last 2 chars shown for verification UX
  expiresAt      DateTime
  usedAt         DateTime?
  revokedAt      DateTime?
  createdAt      DateTime       @default(now())
}

// ───────────── Showroom test-drive appointments ─────────────

model TestDrive {
  id               String   @id @default(cuid())
  refCode          String   @unique
  orgId            String
  org              Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  vehicleId        String
  vehicle          Vehicle  @relation(fields: [vehicleId], references: [id])
  customerId       String
  customer         User     @relation("TestDrives", fields: [customerId], references: [id])
  scheduledAt      DateTime
  status           String   @default("REQUESTED") // REQUESTED|CONFIRMED|IN_PROGRESS|COMPLETED|NO_SHOW|CANCELLED
  licenceConfirmed Boolean  @default(false) // customer confirms valid licence
  odometerOut      Int?
  odometerIn       Int?
  fuelOut          String?
  fuelIn           String?
  conditionOut     String?
  conditionIn      String?
  releasedBy       String? // staff who authorised vehicle release
  returnedBy       String?
  startedAt        DateTime?
  endedAt          DateTime?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([orgId, status])
  @@index([customerId])
}

// ───────────── Security incidents ─────────────

model SecurityIncident {
  id             String   @id @default(cuid())
  refCode        String   @unique
  category       String
  // STOLEN_VEHICLE|MISSING_FROM_GARAGE|TEST_DRIVE_NOT_RETURNED|UNAUTHORISED_USE|UNAUTHORISED_RELEASE|DAMAGE_IN_CUSTODY|MISSING_PROPERTY|OWNERSHIP_FRAUD|FAKE_DOCS|MISCONDUCT|CUSTOMER_FRAUD|OTHER
  reporterId     String
  reporter       User     @relation("Incidents", fields: [reporterId], references: [id])
  reporterSide   String // CUSTOMER|ORG
  orgId          String? // involved business (plain ref, no cascade)
  custodyId      String?
  testDriveId    String?
  vehicleDesc    String?
  subjectDesc    String? // restricted: person/organisation under review
  title          String
  details        String
  evidence       String? // JSON [{url,name,uploadedAt}]
  status         String   @default("OPEN") // OPEN|UNDER_REVIEW|RESOLVED|DISMISSED|ESCALATED
  severity       String   @default("MEDIUM") // LOW|MEDIUM|HIGH|CRITICAL
  assignedTo     String?
  resolutionNote String?
  resolvedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  timeline IncidentEvent[]

  @@index([status, severity])
}

model IncidentEvent {
  id         String           @id @default(cuid())
  incidentId String
  incident   SecurityIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  type       String // CREATED|NOTE|STATUS_CHANGE|EVIDENCE|ESCALATION|RESOLUTION
  actorId    String?
  actorName  String
  note       String?
  createdAt  DateTime         @default(now())
}

model Org {
  id          String   @id @default(cuid())
  type        String // DEALER | GARAGE | SUPPLIER
  verified    Boolean  @default(false) // set when onboarding application is approved + docs reviewed
  // Garage procurement: purchase orders above this threshold require owner approval (minor units, null = no approval gate)
  poApprovalThresholdMinor Int?
  supplierRating   Float?  // cached average of OrgReview ratings
  supplierRiskScore Int    @default(0) // 0 = clean; admin raises on fraud/disputes (>=60 = high risk)
  name        String
  regNo       String?
  county      String
  town        String?
  location    String?
  phone       String?
  email       String?
  description String?
  status      String   @default("ACTIVE") // ACTIVE | SUSPENDED
  isDemo      Boolean  @default(false) // demo-experience organisation: demo users can act on it; real users' data never mixes
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members    OrgMember[]
  vehicles   Vehicle[]
  offers     Offer[]
  buyingReqs BuyingRequest[]
  services   GarageService[]
  quotes     Quote[]
  bookings   Booking[]
  reviews    OrgReview[]
  invoices   Invoice[]
  subscription Subscription?
  campaigns  Campaign[]

  // ── Storefront (public business page) ──
  logoUrl         String?
  coverUrl        String?
  gallery         String? // JSON string[] of image urls
  openingHours    String? // JSON {"mon":["08:00","18:00"],…} null value = closed
  specialities    String? // JSON string[]
  faqs            String? // JSON [{q,a}]
  serviceAreas    String? // JSON string[] of counties/areas served
  whatsappEnabled Boolean @default(false)
  callEnabled     Boolean @default(true)
  responseMinutes Int? // expected response time in minutes (self-reported)

  // ── Relations ──
  conversations Conversation[]
  custodies     VehicleCustody[]
  testDrives    TestDrive[]

  // ── Supply network & multi-branch ──
  branches        OrgBranch[]
  products        Product[]
  membershipTiers MembershipTier[]
  trustProgrammes TrustProgramme[]
  creditIssued    CreditFacility[] @relation("CreditIssuer")
  poAsGarage      PurchaseOrder[]  @relation("POGarage")
  poAsSupplier    PurchaseOrder[]  @relation("POSupplier")
  quoteOffers     QuoteOffer[]
  vehicleTransfers VehicleTransfer[] @relation("TransferOwner")
  memberOrg       BusinessMembership[] @relation("MembershipOrg")
  customerOrdersAsSupplier CustomerOrder[] @relation("CustomerOrderSupplier")
  verificationDocuments VerificationDocument[] @relation("DocumentOrg")
  settlements    Settlement[] @relation("SupplierSettlements")
}

model OrgMember {
  id     String   @id @default(cuid())
  orgId  String
  userId String
  role   String // OWNER | MANAGER | SALES | FINANCE | STAFF (dealer) / OWNER | MANAGER | MECHANIC | STAFF (garage)
  org    Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([orgId, userId])
  @@index([userId])
}

// ───────────────────────── Dealer / Garage onboarding ─────────────────────────

model Application {
  id               String    @id @default(cuid())
  refCode          String    @unique
  type             String // DEALER | GARAGE | SELLER | LOGISTICS
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgName          String
  regNo            String?
  county           String
  town             String?
  physicalAddress  String?
  phone            String
  email            String?
  representative   String
  accountType      String? // dealer plan interest
  categories       String? // garage: comma separated service categories
  documents        String? // JSON [{name,url,uploadedAt}]
  consent          Boolean   @default(false)
  notes            String?
  status           String    @default("DRAFT") // DRAFT|SUBMITTED|UNDER_REVIEW|MORE_INFO_REQUIRED|RESUBMITTED|APPROVED|REJECTED|SUSPENDED|REVOKED
  reviewSlaHours   Int       @default(24)
  submittedAt      DateTime?
  reviewOwnerId    String?
  reviewOwnerName  String?
  decisionNote     String?
  infoRequestedAt  DateTime?
  correctionsDueAt DateTime?
  lastReminderAt   DateTime?
  reminderCount    Int       @default(0)
  escalated        Boolean   @default(false)
  escalatedAt      DateTime?
  orgId            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  events ApplicationEvent[]
  verificationDocuments VerificationDocument[]

  @@index([status, submittedAt])
}

model ApplicationEvent {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          String // SUBMITTED|REVIEW_ASSIGNED|INFO_REQUESTED|RESUBMITTED|REMINDER|ESCALATED|APPROVED|REJECTED|NOTE|STATUS_CHANGED
  actorId       String?
  actorName     String?
  note          String?
  createdAt     DateTime    @default(now())
}

// ─────────────────────────────── Marketplace ───────────────────────────────

model Vehicle {
  id               String   @id @default(cuid())
  refCode          String   @unique
  ownerId          String
  owner            User     @relation("VehicleOwner", fields: [ownerId], references: [id])
  orgId            String?
  org              Org?     @relation(fields: [orgId], references: [id])
  make             String
  model            String
  year             Int
  priceMinor       Int
  currency         String   @default("KES")
  mileageKm        Int
  fuel             String // PETROL|DIESEL|HYBRID|ELECTRIC
  transmission     String // MANUAL|AUTOMATIC
  bodyType         String // SUV|SEDAN|HATCHBACK|PICKUP|MINIVAN|COUPE|WAGON|MOTORBIKE|TRUCK
  engineCc         Int?
  condition        String // BRAND_NEW|FOREIGN_USED|LOCAL_USED
  county           String
  town             String?
  color            String
  description      String
  branchId         String?  // showroom branch holding this vehicle (single authoritative inventory record)
  branch           OrgBranch? @relation(fields: [branchId], references: [id])
  sellerType       String   @default("PRIVATE") // PRIVATE|DEALER
  status           String   @default("DRAFT") // DRAFT|PENDING_REVIEW|PUBLISHED|RESERVED|SOLD|REJECTED|SUSPENDED|EXPIRED
  reviewNote       String?
  matchWithDealers Boolean  @default(false)
  featured         Boolean  @default(false)
  views            Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  photos   VehiclePhoto[]
  events   ListingEvent[]
  savedBy  SavedVehicle[]
  enquiries Enquiry[]
  offers   Offer[]
  campaigns Campaign[]
  conversations Conversation[]
  testDrives    TestDrive[]
  transfers VehicleTransfer[]

  @@index([status, make])
  @@index([status, bodyType])
  @@index([status, priceMinor])
  @@index([status, county])
  @@index([status, createdAt])
  @@index([ownerId])
  @@index([orgId])
}

model VehiclePhoto {
  id        String  @id @default(cuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  url       String
  order     Int     @default(0)
}

model ListingEvent {
  id        String   @id @default(cuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  from      String?
  to        String
  actorId   String?
  actorName String?
  note      String?
  createdAt DateTime @default(now())
}

model SavedVehicle {
  id        String   @id @default(cuid())
  userId    String
  vehicleId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, vehicleId])
}

model SavedSearch {
